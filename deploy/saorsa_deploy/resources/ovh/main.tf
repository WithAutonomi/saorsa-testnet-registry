# Look up the b3-16 (or whichever flavor) by name in the target region; the
# OVH instance resource needs a flavor_id, not a name.
data "ovh_cloud_project_flavors" "selected" {
  service_name = var.service_name
  region       = var.region
  name_filter  = var.flavor_name
}

# Look up Linux images in the region; pick the latest matching the chosen
# Ubuntu name pattern.
data "ovh_cloud_project_images" "linux" {
  service_name = var.service_name
  region       = var.region
  os_type      = "linux"
}

locals {
  flavor_id = one(data.ovh_cloud_project_flavors.selected.flavors).id

  ubuntu_images = [
    for img in data.ovh_cloud_project_images.linux.images :
    img if can(regex(var.ubuntu_image_name_pattern, img.name))
  ]
  ubuntu_image_id = local.ubuntu_images[0].id
}

# OpenStack-compatible user used by the openstack provider for volume attach.
# compute_operator + volume_operator give us instance + volume + attachment
# permissions. The user is project-scoped; password is generated by OVH and
# only retrievable on creation, so it lives in the Terraform state thereafter.
resource "ovh_cloud_project_user" "attach_user" {
  service_name = var.service_name
  description  = "saorsa-deploy: openstack auth for ${var.name}-${var.region}"
  role_names   = ["compute_operator", "volume_operator"]
}

resource "ovh_cloud_project_instance" "node_vm" {
  count          = var.vm_count
  service_name   = var.service_name
  region         = var.region
  billing_period = "hourly"
  name           = "${var.name}-${var.name_template}-${var.region}-${count.index + 1 + var.name_index_offset}"

  boot_from {
    image_id = local.ubuntu_image_id
  }

  flavor {
    flavor_id = local.flavor_id
  }

  ssh_key {
    name = var.ssh_key_name
  }

  network {
    public = true
  }
}

resource "ovh_cloud_project_volume" "node_storage" {
  count        = var.vm_count
  service_name = var.service_name
  region_name  = var.region
  size         = var.attached_volume_size
  type         = var.volume_type
  name         = "${lower(var.name)}-${var.name_template}-storage-${var.region}-${count.index + 1 + var.name_index_offset}"
  description  = "Data volume for ant-node services on ${ovh_cloud_project_instance.node_vm[count.index].name}"
}

# OVH's Terraform provider has no native volume-attach resource, so we go
# through the OpenStack provider (Cinder volume attach) using credentials
# minted by ovh_cloud_project_user above. The instance and volume IDs are
# the OpenStack server/volume UUIDs.
resource "openstack_compute_volume_attach_v2" "node_storage_attach" {
  count       = var.vm_count
  instance_id = ovh_cloud_project_instance.node_vm[count.index].id
  volume_id   = ovh_cloud_project_volume.node_storage[count.index].id
}
