# This file is the CHECKOUT's environment: `uv run` here reads it, and so does
# the registry web app and Alembic. An INSTALLED copy of `saorsa-deploy` (a
# wheel, run with `uvx` or from a venv) does NOT — it is not in a checkout, so
# there is no `.env` above it to find.
#
# An installed copy reads the environment and ONE file of its own:
#
#     ~/.config/saorsa-deploy/env     (or whatever $SAORSA_DEPLOY_ENV_FILE names)
#
# Same format as this file — flat `KEY=value`, one per line, `#` comments,
# optional quotes, no evaluation — so it is also loadable by systemd's
# `EnvironmentFile=` and by a runner that exports it into a session. Precedence
# is: the environment wins, then that file, then `./.env`. So a variable set for
# one invocation always overrides the file, and this file still works unchanged
# for `uv run` in the checkout.
#
# The credentials the tool needs are not all listed below — the provider tokens
# (DO_TOKEN, HCLOUD_TOKEN, VULTR_API_KEY, the OVH_* and CNTB_OAUTH2_* sets), the
# AWS keys and the wallet keys live in the operator's shell today. Run
# `saorsa-deploy config env-file` for the full list and which of them are set.

# For a purely local Postgres, the default below works. To use the SHARED DO
# Managed Postgres cluster instead (so deployment history is shared across
# people), get the connection string from the Terraform module and paste it here:
#   terraform -chdir=deploy/saorsa_deploy/resources/digitalocean-registry-db output -raw database_url
# (Provision the cluster once with `terraform ... apply -var do_token=$DO_TOKEN`.)
# The managed URL includes `?sslmode=require`. Never commit the real value.
DATABASE_URL=postgresql://saorsa_testnet:saorsa_testnet@localhost:5432/saorsa_testnet_registry
FLASK_SECRET_KEY=change-me-to-a-random-secret
WORKFLOW_RUNNER_PAT=ghp_your_github_pat_here
GITHUB_REPO=maidsafe/saorsa-testnet-registry
WORKFLOW_FILE=launch-testnet.yml
REGISTRY_URL=http://localhost:5000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REGISTRY_API_TOKEN=

# Optional. Raises the GitHub REST limit used for ant/ant-node release lookups
# from 60/hour (unauthenticated) to 5000/hour. Without it, a burst of deploys
# can hit the limit and make valid release versions look "not found".
# GH_TOKEN is accepted as a fallback (the gh-CLI spelling). A read-only/public
# token is sufficient.
GITHUB_TOKEN=

# Client-VM S3 access credentials (for upload/download address coordination).
# Create these once with: terraform -chdir=deploy/saorsa_deploy/resources/aws-client-s3 apply
# Then: terraform output -raw access_key_id and terraform output -raw secret_access_key
ANT_CLIENT_AWS_ACCESS_KEY_ID=
ANT_CLIENT_AWS_SECRET_ACCESS_KEY=
